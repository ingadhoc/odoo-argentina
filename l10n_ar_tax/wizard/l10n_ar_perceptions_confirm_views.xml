<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="l10n_ar_perceptions_confirm_view_form" model="ir.ui.view">
        <field name="name">l10n_ar.perceptions.confirm.form</field>
        <field name="model">l10n_ar.perceptions.confirm</field>
        <field name="arch" type="xml">
            <form>
                <div class="alert alert-warning mb-0" role="alert">
                    <field name="message" nolabel="1"/>
                </div>
                <footer>
                    <button name="action_confirm" string="Confirm anyway" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
