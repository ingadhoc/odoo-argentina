<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="l10n_ar_ux_partner_responsibility_form" model="ir.ui.view">
        <field name="name">l10n_ar_ux.partner.responsibility.form</field>
        <field name="model">l10n_ar_ux.partner.responsibility</field>
        <field name="arch" type="xml">
            <form>
                <field name="move_id" invisible="1"/>
                <group>
                    <field name="partner_id" readonly="1" class="oe_inline" options="{'no_open': True}"/>
                    <field name="responsibility_id" class="oe_inline"
                           options="{'no_open': True, 'no_create': True}"/>
                </group>
                <div class="text-muted">
                    It is saved on the contact, not on this invoice.
                </div>
                <footer>
                    <button name="action_apply" type="object" string="Save" class="btn-primary"
                            data-hotkey="q"/>
                    <button string="Discard" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
