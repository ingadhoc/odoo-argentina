<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tax_group_form" model="ir.ui.view">
        <field name="name">account.tax.group.inherit</field>
        <field name="model">account.tax.group</field>
        <field name="inherit_id" ref="account.view_tax_group_form"/>
        <field name="arch" type="xml">
            <field name="preceding_subtotal" position="after">
                <field name="l10n_ar_state_id" invisible="country_id != %(base.ar)d"/>
                <field name="l10n_ar_withholding_sequence_id" invisible="country_id != %(base.ar)d"/>
            </field>
        </field>
    </record>

</odoo>
